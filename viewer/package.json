{
  "name": "iso20022kit-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Reads and checks ISO 20022 messages in the browser. Nothing is uploaded.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --minify --format=esm --target=es2020 --loader:.xml=text --outfile=dist/app.js && node scripts/copy.mjs",
    "dev": "node scripts/copy.mjs && esbuild src/app.ts --bundle --format=esm --target=es2020 --loader:.xml=text --outfile=dist/app.js --servedir=dist --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/conformance.test.ts --bundle --platform=node --format=esm --outfile=.test/conformance.mjs --log-level=warning && node --test .test/conformance.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@types/node": "^22.20.5"
  }
}
